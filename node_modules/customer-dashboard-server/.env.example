# ============================================================
#  Customer Dashboard – Backend Server Umgebungsvariablen
#  Kopieren: cp .env.example .env
#  (Root .env.example enthält alle Vars inkl. Frontend)
# ============================================================

PORT=3000
NODE_ENV=development

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# ── n8n ─────────────────────────────────────────────────────
N8N_API_URL=http://localhost:5678
N8N_API_KEY=dein-n8n-api-key

# ── CORS ────────────────────────────────────────────────────
WEBAPP_URL=http://localhost:5173

# ── JWT (optional) ──────────────────────────────────────────
# JWT_SECRET=mindestens-32-zeichen-langes-geheimnis
