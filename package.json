{
  "name": "flowtecsm-template",
  "version": "1.0.0",
  "description": "FlowTecsMedia Projekt Template",
  "private": true,
  "scripts": {
    "version:current": "node .vscode/scripts/bump-version.js current",
    "version:patch":   "node .vscode/scripts/bump-version.js patch",
    "version:minor":   "node .vscode/scripts/bump-version.js minor",
    "version:major":   "node .vscode/scripts/bump-version.js major",
    "deploy:website":  "node deploy/sftp/deploy-website.js",
    "deploy:dry-run":  "node deploy/sftp/deploy-website.js --dry-run",
    "lint":            "npm run lint --workspaces --if-present",
    "typecheck":       "npm run typecheck --workspaces --if-present",
    "test":            "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "src/frontend/website",
    "src/frontend/webapp",
    "src/backend/server"
  ],
  "devDependencies": {
    "dotenv":           "^16.4.5",
    "ssh2-sftp-client": "^11.0.0"
  }
}
