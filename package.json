{
  "name": "customer-dashboard",
  "version": "0.1.0",
  "description": "Modulares Kunden-Dashboard – Automationen, KPIs, Incidents, Roadmap",
  "private": true,
  "scripts": {
    "version:current": "node .vscode/scripts/bump-version.js current",
    "version:patch":   "node .vscode/scripts/bump-version.js patch",
    "version:minor":   "node .vscode/scripts/bump-version.js minor",
    "version:major":   "node .vscode/scripts/bump-version.js major",
    "lint":            "npm run lint --workspaces --if-present",
    "typecheck":       "npm run typecheck --workspaces --if-present",
    "test":            "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "src/frontend/webapp",
    "src/backend/server"
  ],
  "devDependencies": {
    "dotenv": "^16.4.5"
  }
}
