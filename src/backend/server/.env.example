# ============================================================
#  FlowTecsMedia – Backend Server Umgebungsvariablen
#  Kopieren: cp .env.example .env
#  (Root .env.example enthält alle Vars inkl. Frontend)
# ============================================================

PORT=3000
NODE_ENV=development

# ── Datenbank ─────────────────────────────────────────────────
# 'supabase' oder 'mysql'
DB_TYPE=supabase

# Supabase (falls DB_TYPE=supabase)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# MySQL (falls DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=flowtecsm
MYSQL_USER=flowtecsm
MYSQL_PASSWORD=sicheres-passwort

# ── n8n ───────────────────────────────────────────────────────
N8N_API_URL=http://localhost:5678
N8N_API_KEY=dein-n8n-api-key

# ── CORS ──────────────────────────────────────────────────────
WEBSITE_URL=http://localhost:5174
WEBAPP_URL=http://localhost:5173

# ── JWT (falls eigene Auth ohne Supabase) ─────────────────────
# JWT_SECRET=mindestens-32-zeichen-langes-geheimnis
