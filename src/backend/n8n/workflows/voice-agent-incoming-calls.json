    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/voice-agent/webhook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"direction\": \"{{ $json.direction }}\",\n  \"status\": \"completed\",\n  \"caller_number\": \"{{ $json.caller_number }}\",\n  \"callee_number\": \"{{ $json.callee_number }}\",\n  \"duration_seconds\": {{ Math.round(($now.toMillis() - new Date($json.started_at).getTime()) / 1000) }},\n  \"sentiment\": \"{{ $json.sentiment }}\",\n  \"summary\": \"{{ $json.response_text.substring(0, 200).replace(/\"/g, '\\\\\"') }}\",\n  \"transcript\": \"Anrufer: {{ $json.caller_text.replace(/\"/g, '\\\\\"') }}\\n\\nAssistent: {{ $json.response_text.replace(/\"/g, '\\\\\"') }}\",\n  \"provider\": \"n8n\",\n  \"started_at\": \"{{ $json.started_at }}\",\n  \"ended_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "headers": {
            "parameters": [
              {
                "name": "x-webhook-secret",
                "value": "whsec_va_2026_cUd4shB0aRd"
              }
            ]
          }
        }
      },
