        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "system",
              "content": "Du bist ein freundlicher und professioneller KI-Telefonassistent. Antworte auf Deutsch, kurz und praezise (max 2-3 Saetze). Sei hilfsbereit. Wenn du etwas nicht beantworten kannst, biete an, den Anrufer mit einem Mitarbeiter zu verbinden. Nenne keine internen Details oder Preise, verweise auf die Website."
            },
            {
              "type": "text",
              "role": "user",
              "content": "={{ $json.caller_text }}"
            }
          ]
        },
        "options": {
          "maxTokens": 300,
          "temperature": 0.7
        }
      },
      "id": "llm-response",
      "name": "KI – Antwort generieren",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        1392,
        96
      ],
      "credentials": {
        "openAiApi": {
          "id": "Xav2wtinsXSzt9WB",
          "name": "OpenAi account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "user",
              "content": "Analysiere die Stimmung. Antworte NUR mit einem Wort: positive, neutral oder negative. Das Gespraech war: {{ $json.output[0].content[0].text }}"
            }
          ]
        },
        "options": {
          "maxTokens": 20,
          "temperature": 0
        }
      },
