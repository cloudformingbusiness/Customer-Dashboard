{
  "version": "2.0.0",
  "tasks": [

    // ═══════════════════════════════════════════════════
    //  🚀 SCHNELLSTART
    // ═══════════════════════════════════════════════════

    {
      "label": "🚀 Dashboard + Backend starten",
      "dependsOn": ["Dashboard starten", "Backend starten"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  INSTALLATION
    // ═══════════════════════════════════════════════════

    {
      "label": "npm install (alle Packages)",
      "type": "shell",
      "command": "bash scripts/install-all.sh",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File scripts/install-all.ps1" },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Install" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  STARTEN
    // ═══════════════════════════════════════════════════

    {
      "label": "Dashboard starten",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/src/frontend/webapp" },
      "group": "build",
      "presentation": { "panel": "new", "reveal": "always", "tabName": "Dashboard" },
      "problemMatcher": []
    },
    {
      "label": "Backend starten",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/src/backend/server" },
      "group": "build",
      "presentation": { "panel": "new", "reveal": "always", "tabName": "Backend" },
      "problemMatcher": []
    },
    {
      "label": "n8n starten (Docker)",
      "type": "shell",
      "command": "docker compose up n8n -d && echo 'n8n laeuft auf http://localhost:5678'",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "n8n" },
      "problemMatcher": []
    },

    // ── Kombiniert ──────────────────────────────────────

    {
      "label": "Alles starten",
      "dependsOn": [
        "Dashboard starten",
        "Backend starten",
        "n8n starten (Docker)"
      ],
      "group": "build",
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  BUILD
    // ═══════════════════════════════════════════════════

    {
      "label": "Dashboard bauen",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/src/frontend/webapp" },
      "group": "build",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Build" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Backend bauen",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/src/backend/server" },
      "group": "build",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Build" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Alles bauen",
      "dependsOn": ["Dashboard bauen", "Backend bauen"],
      "group": "build",
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  TESTS
    // ═══════════════════════════════════════════════════

    {
      "label": "Dashboard testen",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}/src/frontend/webapp" },
      "group": "test",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Tests" },
      "problemMatcher": []
    },
    {
      "label": "Backend testen",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}/src/backend/server" },
      "group": "test",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Tests" },
      "problemMatcher": []
    },
    {
      "label": "Alle Tests",
      "dependsOn": ["Dashboard testen", "Backend testen"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  VERSION BUMPING
    // ═══════════════════════════════════════════════════

    {
      "label": "Version: Patch bumpen (1.0.x)",
      "type": "shell",
      "command": "node .vscode/scripts/bump-version.js patch",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Version" },
      "problemMatcher": []
    },
    {
      "label": "Version: Minor bumpen (1.x.0)",
      "type": "shell",
      "command": "node .vscode/scripts/bump-version.js minor",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Version" },
      "problemMatcher": []
    },
    {
      "label": "Version: Major bumpen (x.0.0)",
      "type": "shell",
      "command": "node .vscode/scripts/bump-version.js major",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Version" },
      "problemMatcher": []
    },
    {
      "label": "Version anzeigen",
      "type": "shell",
      "command": "node .vscode/scripts/bump-version.js current",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Version" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  POSTMAN / NEWMAN (API Tests)
    // ═══════════════════════════════════════════════════

    {
      "label": "Postman: Collection gegen Local laufen lassen",
      "type": "shell",
      "command": "npx newman run postman/FlowTecsMedia.postman_collection.json -e postman/FlowTecsMedia-Local.postman_environment.json --reporters cli,json --reporter-json-export postman/results/last-run.json",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Postman" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  DATENBANK (Supabase)
    // ═══════════════════════════════════════════════════

    {
      "label": "DB: Supabase Schema pushen",
      "type": "shell",
      "command": "npx supabase db push",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Datenbank" },
      "problemMatcher": []
    },
    {
      "label": "DB: Supabase lokal starten",
      "type": "shell",
      "command": "npx supabase start",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "new", "reveal": "always", "tabName": "Supabase Local" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════════
    //  DOCKER
    // ═══════════════════════════════════════════════════

    {
      "label": "Docker: Alle Services starten",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Docker" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Alle Services stoppen",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "shared", "reveal": "always", "tabName": "Docker" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs anzeigen",
      "type": "shell",
      "command": "docker compose logs -f",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "panel": "new", "reveal": "always", "tabName": "Docker Logs" },
      "problemMatcher": []
    }

  ],

  "inputs": [
    {
      "id": "manualVersion",
      "type": "promptString",
      "description": "Versionsnummer eingeben (z.B. 2.1.0)",
      "default": "1.0.0"
    }
  ]
}
