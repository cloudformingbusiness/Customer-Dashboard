# ============================================================
#  FlowTecsMedia – Umgebungsvariablen
#  Kopieren: cp .env.example .env
# ============================================================

# ── Datenbank-Typ wählen ─────────────────────────────────────
# 'supabase' = Supabase (Cloud oder self-hosted)
# 'mysql'    = MySQL (z.B. auf Hetzner via Coolify)
DB_TYPE=supabase

# ── Web App (src/frontend/webapp) ────────────────────────────
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
VITE_API_URL=http://localhost:3000

# ── Website (src/frontend/website) ───────────────────────────
VITE_API_URL=http://localhost:3000

# ── Mobile App (src/frontend/mobileapp) ──────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Backend Server (src/backend/server) ──────────────────────
PORT=3000
NODE_ENV=development

# Supabase (falls DB_TYPE=supabase)
# Service Role Key – NIEMALS im Frontend verwenden!
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# MySQL (falls DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=flowtecsm
MYSQL_USER=flowtecsm
MYSQL_PASSWORD=sicheres-passwort
MYSQL_ROOT_PASSWORD=root-passwort

# ── n8n ──────────────────────────────────────────────────────
N8N_API_URL=https://n8ndeploy.cloudforming.de/
N8N_API_KEY=dein-n8n-api-key
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=sicheres-passwort

# ── SFTP Deploy (deploy/sftp/deploy-website.js) ──────────────
SFTP_HOST=deine-server-ip-oder-domain.de
SFTP_PORT=22
SFTP_USER=dein-sftp-user
SFTP_PASSWORD=                          # oder SFTP_KEY_PATH verwenden
SFTP_KEY_PATH=~/.ssh/id_ed25519        # Empfohlen statt Passwort
SFTP_REMOTE_DIR=/var/www/html
WEBSITE_URL=https://www.deine-domain.de
WEBAPP_URL=https://app.deine-domain.de

# ── Coolify Deployment (GitHub Actions) ──────────────────────
# Coolify → Deine App → Settings → Deploy Webhook
COOLIFY_WEBHOOK_URL=https://coolify.deine-domain.de/api/v1/deploy/webhook/...
COOLIFY_TOKEN=dein-coolify-api-token

# JWT (optional – nur bei eigener Auth ohne Supabase)
JWT_SECRET=mindestens-32-zeichen-langes-geheimnis-hier-eintragen

# ── KI APIs ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Kie.ai (KI-API-Aggregation: Video, Bild, Musik, LLM) ──
# Dashboard & API Key: https://kie.ai → Dashboard → API Key
# Docs: https://docs.kie.ai
KIE_API_KEY=dein-kie-api-key
KIE_API_URL=https://api.kie.ai

# Tests (optional – für API-Tests mit Auth)
# TEST_TOKEN=eyJ...  ← aus Supabase Dashboard kopieren
